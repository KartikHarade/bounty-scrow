# Deployer Wallet Private Key (Keep secret! Do not commit real keys)
DEPLOYER_PRIVATE_KEY=your_private_key_here
PRIVATE_KEY=your_private_key_here

# Monad Testnet RPC Configuration
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Deployed Contract Address (populated after running deployment script)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Chain Configuration
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadexplorer.com
